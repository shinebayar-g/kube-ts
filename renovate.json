{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "2 days",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "5 days"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "10 days"
    },
    {
      "matchPackageNames": [
        "@types/node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "vite-plus and the vite catalog alias (vite-plus-core) must move together",
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core"
      ],
      "groupName": "vite-plus"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": null
    }
  ]
}
