{
  "name": "@kube-ts/k8s",
  "version": "1.32.0",
  "author": {
    "name": "shinebayar-g",
    "url": "https://github.com/shinebayar-g"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/shinebayar-g/kube-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinebayar-g/kube-ts.git",
    "directory": "packages/k8s"
  },
  "bugs": {
    "url": "https://github.com/shinebayar-g/kube-ts/issues"
  },
  "keywords": [
    "kube-ts",
    "typescript",
    "kubernetes",
    "cdk8s",
    "cdk",
    "helm"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/models/*.d.mts",
        "import": "./dist/models/*.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/models/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@kube-ts/core": "workspace:*",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@kube-ts/core": "workspace:^"
  }
}
