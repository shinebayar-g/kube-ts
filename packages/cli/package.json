{
  "name": "@kube-ts/cli",
  "version": "0.6.3",
  "author": {
    "name": "shinebayar-g",
    "url": "https://github.com/shinebayar-g"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/shinebayar-g/kube-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinebayar-g/kube-ts.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/shinebayar-g/kube-ts/issues"
  },
  "keywords": [
    "kube-ts",
    "typescript",
    "kubernetes",
    "cdk8s",
    "cdk",
    "helm"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "kube-ts": "./dist/index.js"
    },
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "bin": {
    "kube-ts": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome lint",
    "gen": "rm -rf ./gen && openapi-generator-cli generate",
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@kube-ts/core": "workspace:*",
    "@openapitools/openapi-generator-cli": "2.30.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "json-schema-to-typescript": "^15.0.4",
    "picocolors": "^1.1.1",
    "ts-morph": "^27.0.2",
    "yaml": "^2.8.3"
  }
}
